{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "data": {
    "type": "object",
    "required": ["columns", "rows"],
    "properties": {
      "title": { "type": "string" },
      "caption": { "type": "string" },
      "columns": { "type": "array", "items": { "type": "string" } },
      "rows": {
        "type": "array",
        "items": {
          "type": "array",
          "items": { "type": ["string", "number", "boolean", "null"] }
        }
      }
    }
  }
}
