+import { Mutex } from "./mutex"
+
+/** 사용자마다 갱신을 하나씩만 돌린다. 5초가 지나면 락을 푼다. */
+export const refreshLock = new Mutex({ ttlMs: 5_000 })
+
+export function lockKey(userId: string): string {
+  return `refresh:${userId}`
+}
